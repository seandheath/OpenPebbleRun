<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Required by CompanionDeviceManager.associate() per Android's
        feature gate. Without it, associate() throws IllegalStateException
        even when the REQUEST_COMPANION_* permissions are declared.
        required="false" because the device may not have CDM support
        below API 26, where we silently no-op the pairing flow.
    -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!--
        Permissions (spec §9).

        BLUETOOTH_CONNECT is required by PebbleKitAndroid2 on Android 12+.

        Deliberately NOT requested: location, storage, internet, and
        QUERY_ALL_PACKAGES.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        Foreground-service support for run state (spec §5.1). PebbleListenerService
        promotes itself to a foreground service while a run is active so the OS
        doesn't reap us mid-run and so the CMD_STOP → publicapi.StopRecording
        dispatch gets BAL allowance from a backgrounded process. Mirrors
        OpenTracks's own TrackRecordingService pattern.

        FOREGROUND_SERVICE_CONNECTED_DEVICE is required on API 34+ to match the
        service's android:foregroundServiceType="connectedDevice" declaration.
        POST_NOTIFICATIONS is requested at runtime in MainActivity on API 33+;
        if denied the service still gets foreground state (just no visible
        notification), so the watch-driven flow keeps working.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        android:minSdkVersion="34" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />

    <!--
        CompanionDeviceManager BAL exemption (spec §5.1). Both are
        normal-level: declaring them is necessary, but the actual grant
        only takes effect once the user completes the CDM pairing dialog.
        With an active association, Android short-circuits BAL to
        BAL_ALLOW_ALLOWLISTED_COMPONENT for our UID — letting the listener
        service dispatch OpenTracks's publicapi.StopRecording from a
        watch-button callback long after the FGS BAL window has lapsed.
    -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_RUN_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <!--
        Required to use AssociationRequest.setDeviceProfile(DEVICE_PROFILE_WATCH).
        Without it, CompanionDeviceManager.associate() throws SecurityException.
        Normal permission, granted at install on API 30+.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_COMPANION_PROFILE_WATCH"
        android:minSdkVersion="30" />


    <!--
        Package visibility on Android 11+ (API 30+) requires explicit declarations
        for any package we resolve or any Intent action we send. Spec §9.
    -->
    <queries>
        <!-- OpenTracks variants (spec §5.4 probe order). -->
        <package android:name="de.dennisguse.opentracks" />
        <package android:name="de.dennisguse.opentracks.playstore" />
        <package android:name="de.dennisguse.opentracks.debug" />
        <package android:name="de.dennisguse.opentracks.nightly" />

        <!--
            PebbleKitAndroid2 picker (spec §9): on Android 11+ the library
            enumerates components handling this action to find the Pebble
            companion app (`coredevices.coreapp`, min v1.0.7.7).
        -->
        <intent>
            <action android:name="io.rebble.pebblekit2.RECEIVE_DATA_FROM_WATCH" />
        </intent>

        <!-- OpenTracks Public API Start/Stop intent actions, used for resolveActivity probes. -->
        <intent>
            <action android:name="de.dennisguse.opentracks.publicapi.StartRecording" />
        </intent>
        <intent>
            <action android:name="de.dennisguse.opentracks.publicapi.StopRecording" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_directions"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenPebbleRun">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            DashboardActivity is the target OpenTracks invokes after StartRecording
            via STATS_TARGET_PACKAGE/STATS_TARGET_CLASS extras (spec §6.1, §6.2).
            Must be exported so OpenTracks can launch it with the Track + TrackPoints
            content URIs and FLAG_GRANT_READ_URI_PERMISSION.

            Phase B: declared but a stub. Phase C: receives + logs the URIs.
        -->
        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:label="@string/dashboard_label" />

        <!--
            PebbleKitAndroid2 bound service. Spec §3, §5.1.

            The Pebble companion app on the phone (`coredevices.coreapp` ≥ 1.0.7.7)
            binds to this service when our watchapp opens. Service self-terminates
            a few seconds after the last watchapp closes (per library docs).

            android:exported="true" with an intent-filter is required for the
            Pebble companion app to resolve us; `tools:ignore="ExportedService"`
            suppresses the lint warning since the access control is enforced by
            the library's [PebbleAndroidAppPicker] (per-package allowlist).
        -->
        <service
            android:name=".pebble.PebbleListenerService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.rebble.pebblekit2.RECEIVE_DATA_FROM_WATCH" />
            </intent-filter>
        </service>

    </application>

</manifest>
